rules_version = '2';
// Sachiv security rules. Each society is visible only to its own approved members.
// Committee (admin) members manage everything; residents see only their own flat.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberPath(sid) { return /databases/$(database)/documents/societies/$(sid)/members/$(request.auth.uid); }
    function isActive(sid) { return signedIn() && exists(memberPath(sid)) && get(memberPath(sid)).data.status == 'active'; }
    function isAdmin(sid) { return isActive(sid) && get(memberPath(sid)).data.role == 'admin'; }
    function myFlat(sid) { return get(memberPath(sid)).data.flatId; }
    function societyPath(sid) { return /databases/$(database)/documents/societies/$(sid); }

    // The app owner: can see every society and extend its plan. Email must be verified.
    function isOwner() {
      return signedIn() && request.auth.token.email == 'sachin.bjankar@gmail.com' && request.auth.token.email_verified == true;
    }
    // Free trial (30 days from registration) or paid plan still running.
    function planOk(sid) {
      let s = get(societyPath(sid)).data;
      let now = request.time.toMillis();
      return s.get('paidUntil', 0) > now || s.get('trialEnds', s.get('createdAt', 0) + 2592000000) > now;
    }
    // Committee work (ledger, notices, approvals) needs an active plan.
    function canManage(sid) { return isAdmin(sid) && planOk(sid); }
    function planKeys() { return ['paidUntil', 'trialEnds', 'lastPaidAt']; }

    // Each person's own list of societies.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Join codes: anyone signed in can look up one code (not list them all).
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && getAfter(societyPath(request.resource.data.sid)).data.createdBy == request.auth.uid
        && getAfter(societyPath(request.resource.data.sid)).data.code == code;
      allow update: if isAdmin(resource.data.sid) && request.resource.data.sid == resource.data.sid;
    }

    match /societies/{sid} {
      allow read: if isActive(sid) || isOwner();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('paidUntil', 0) == 0
        && request.resource.data.trialEnds <= request.time.toMillis() + 2678400000;
      allow update: if (isAdmin(sid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'code', 'createdAt'].concat(planKeys())))
        || (isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(planKeys()));

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin(sid));
        allow create: if signedIn() && request.auth.uid == uid && (
          // a resident asking to join waits for approval
          (request.resource.data.role == 'resident' && request.resource.data.status == 'pending')
          // the person creating a new society becomes its first committee member
          || (request.resource.data.role == 'admin' && request.resource.data.status == 'active'
              && !exists(societyPath(sid))
              && getAfter(societyPath(sid)).data.createdBy == request.auth.uid)
        );
        allow update: if canManage(sid);
        allow delete: if isAdmin(sid) || (signedIn() && request.auth.uid == uid);
      }

      match /accounts/{flatId} {
        allow read: if isAdmin(sid) || (isActive(sid) && myFlat(sid) == flatId);
        allow write: if canManage(sid);
      }

      match /claims/{id} {
        allow read: if isAdmin(sid) || (isActive(sid) && resource.data.flatId == myFlat(sid));
        allow create: if isActive(sid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.flatId == myFlat(sid)
          && request.resource.data.status == 'pending';
        allow update, delete: if canManage(sid);
      }

      match /notices/{id} {
        allow read: if isActive(sid);
        allow write: if canManage(sid);
      }

      // Announcements from the committee
      match /messages/{id} {
        allow read: if isActive(sid);
        allow write: if canManage(sid);
      }

      // Fund collections (वर्गणी): everyone sees progress, committee records payments
      match /funds/{id} {
        allow read: if isActive(sid);
        allow write: if canManage(sid);
      }

      // Society files: committee-only files stay hidden from residents
      match /files/{id} {
        allow read: if isAdmin(sid) || (isActive(sid) && resource.data.visibility == 'all');
        allow write: if canManage(sid);
        match /chunks/{n} {
          allow read: if isAdmin(sid) || (isActive(sid)
            && get(/databases/$(database)/documents/societies/$(sid)/files/$(id)).data.visibility == 'all');
          allow write: if canManage(sid);
        }
      }

      match /complaints/{id} {
        allow read: if isAdmin(sid) || (isActive(sid) && resource.data.uid == request.auth.uid);
        allow create: if isActive(sid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'open'
          && (isAdmin(sid) || request.resource.data.flatId == myFlat(sid));
        allow update, delete: if canManage(sid);
      }
    }
  }
}
